---
import Base from '@/layouts/Base.astro';
import Listado from '@/components/Listado.astro';
import { categorias, productosDe, type Categoria } from '@/lib/catalogo';
import '@/styles/paginas.css';

export function getStaticPaths() {
  return categorias.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props as { c: Categoria };
const items = productosDe(c.slug);
---

<Base title={`${c.titulo} | BUNKERSNEAKERS Bogotá`} description={`${c.descripcion} ${items.length} modelos con guía de tallas oficial. Compra en la web o por WhatsApp.`} page="catalogo">
  <Listado
    titulo={c.nombre}
    kicker={`Categoría · ${items.length} ${items.length === 1 ? 'modelo' : 'modelos'}`}
    descripcion={c.descripcion}
    items={items}
    migas={[{ t: 'Inicio', href: '/' }, { t: 'Sneakers', href: '/sneakers/' }, { t: c.nombre }]}
    actual={`/categoria/${c.slug}/`}
  />
</Base>
